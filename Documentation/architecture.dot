digraph KindredCareersArchitecture {
    // General Graph Settings
    fontname="Helvetica,Arial,sans-serif"
    fontsize=12
    rankdir=LR
    splines=true
    nodesep=0.6
    ranksep=0.8
    bgcolor="#FFFFFF"

    // Default Node Styles
    node [
        fontname="Helvetica,Arial,sans-serif"
        fontsize=11
        shape=box
        style="filled,rounded"
        penwidth=1.5
        margin="0.25,0.15"
    ]

    // Default Edge Styles
    edge [
        fontname="Helvetica,Arial,sans-serif"
        fontsize=9
        penwidth=1.2
        arrowsize=0.8
        color="#475569"
    ]

    // ─────────────────────────────────────────────────────────────
    //  TIER 1: PRESENTATION (FRONTEND)
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_presentation {
        label="Presentation Tier"
        fontname="Helvetica,Arial,sans-serif"
        fontsize=12
        fontcolor="#1E3A8A"
        color="#1E3A8A"
        style="dashed,rounded"
        penwidth=1.5
        margin=20

        flutter_app [
            label="Flutter Mobile Client\n(iOS & Android Application)\n• Stateful Swipe UI\n• Job Card Swiper\n• Profile Management"
            fillcolor="#E0F2FE"
            color="#0284C7"
            fontcolor="#0369A1"
        ]
    }

    // ─────────────────────────────────────────────────────────────
    //  TIER 2: APPLICATION (BACKEND & SERVICES)
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_application {
        label="Application Tier"
        fontname="Helvetica,Arial,sans-serif"
        fontsize=12
        fontcolor="#1E3A8A"
        color="#1E3A8A"
        style="dashed,rounded"
        penwidth=1.5
        margin=20

        fastapi_server [
            label="FastAPI REST API Server\n• Request Routing & Validation\n• Business Logic Services\n• Multi-threaded Uvicorn"
            fillcolor="#ECFDF5"
            color="#059669"
            fontcolor="#047857"
        ]

        rag_engine [
            label="RAG Matching Engine\n• all-MiniLM-L6-v2 Embeddings\n• Cosine Similarity Calculations\n• Score Normalisation & Recency"
            fillcolor="#FFF7ED"
            color="#EA580C"
            fontcolor="#C2410C"
        ]

        cv_service [
            label="CV Generation Service\n• ATS-Optimised Formatting\n• ReportLab PDF Rendering\n• Contextual Prompt Construction"
            fillcolor="#FFF1F2"
            color="#E11D48"
            fontcolor="#BE123C"
        ]

        bg_worker [
            label="Background Worker\n(job_scraper.py)\n• Target Scraping (Wuzzuf)\n• Camoufox / BS4 Parser\n• Scheduled Ingestion"
            fillcolor="#F3F4F6"
            color="#4B5563"
            fontcolor="#374151"
        ]
    }

    // ─────────────────────────────────────────────────────────────
    //  TIER 3: DATA & STORAGE (DATABASES)
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_data {
        label="Data Tier"
        fontname="Helvetica,Arial,sans-serif"
        fontsize=12
        fontcolor="#1E3A8A"
        color="#1E3A8A"
        style="dashed,rounded"
        penwidth=1.5
        margin=20

        firebase_db [
            label="Firebase Firestore\n(Cloud NoSQL)\n• User Authentication Profiles\n• User Attributes & Targets\n• Career-Path Timelines"
            shape=cylinder
            fillcolor="#FEF3C7"
            color="#D97706"
            fontcolor="#B45309"
        ]

        sqlite_db [
            label="SQLite (swipes.db)\n• Local Swipe Logs\n• Swipe Timestamp Tracking\n• Filter-Out IDs Cache"
            shape=cylinder
            fillcolor="#F1F5F9"
            color="#475569"
            fontcolor="#334155"
        ]

        chroma_db [
            label="ChromaDB\n(Vector Database)\n• 384-Dim Job Embeddings\n• Deterministic MD5 IDs\n• Similarity Search Index"
            shape=cylinder
            fillcolor="#E2E8F0"
            color="#475569"
            fontcolor="#334155"
        ]
    }

    // ─────────────────────────────────────────────────────────────
    //  EXTERNAL SERVICES
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_external {
        label="External Services"
        fontname="Helvetica,Arial,sans-serif"
        fontsize=12
        fontcolor="#B4821E"
        color="#B4821E"
        style="dashed,rounded"
        penwidth=1.5
        margin=20

        groq_api [
            label="Groq Cloud LLM\n(LLaMA 3 70B Model)\n• CV Tailoring Prompts\n• Job Desc Bullet Summaries"
            fillcolor="#F3E8FF"
            color="#9333EA"
            fontcolor="#7E22CE"
        ]

        wuzzuf_portal [
            label="Wuzzuf Portal\n(Public Job Board)\n• Raw HTML Target\n• Employment Listings"
            fillcolor="#FEF2F2"
            color="#EF4444"
            fontcolor="#DC2626"
        ]
    }

    // ─────────────────────────────────────────────────────────────
    //  INTER-CONNECTING EDGES (DATA-FLOWS)
    // ─────────────────────────────────────────────────────────────
    // Presentation -> Application
    flutter_app -> fastapi_server [dir=both, label="HTTPS / JSON", color="#0284C7", fontcolor="#0369A1", penwidth=1.5]
    flutter_app -> firebase_db [dir=both, label="Firebase SDK\n(Auth & Profile)", color="#D97706", fontcolor="#B45309"]

    // Application Internal Routing
    fastapi_server -> rag_engine [color="#059669"]
    fastapi_server -> cv_service [color="#059669"]

    // Application -> Data Tier
    fastapi_server -> firebase_db [dir=both, label="Firebase Admin SDK", color="#D97706", fontcolor="#B45309"]
    fastapi_server -> sqlite_db [dir=both, label="SQL (Swipe Log)", color="#475569"]
    rag_engine -> chroma_db [dir=both, label="Query & Filter", color="#EA580C", fontcolor="#C2410C", penwidth=1.5]
    bg_worker -> chroma_db [label="Upsert Vectors", color="#4B5563"]

    // Application -> External APIs
    cv_service -> groq_api [dir=both, label="JSON Schema API", color="#9333EA", fontcolor="#7E22CE", penwidth=1.2]
    bg_worker -> wuzzuf_portal [label="HTTP Get", color="#EF4444", fontcolor="#DC2626"]
    bg_worker -> groq_api [label="Summarise Job", color="#9333EA", fontcolor="#7E22CE"]
}
