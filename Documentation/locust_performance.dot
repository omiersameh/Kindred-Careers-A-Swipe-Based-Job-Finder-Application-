digraph LocustDashboard {
    fontname="Helvetica,Arial,sans-serif";
    node [fontname="Helvetica,Arial,sans-serif", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cccccc"];
    edge [fontname="Helvetica,Arial,sans-serif", color="#666666"];
    rankdir=LR;
    bgcolor="transparent";

    subgraph cluster_load {
        label="Locust Load Generator\nSustained Load: 50 Concurrent Users";
        style=filled;
        fillcolor="#f8f9fa";
        color="#dee2e6";
        fontname="Helvetica-Bold";
        fontsize=14;
        
        LoadInfo [label="Total Requests: ~5,000\nDuration: 120s\nFailure Rate: 0.00%", shape=note, fillcolor="#e9ecef"];
        VirtualUsers [shape=circle, label="50\nUsers", fillcolor="#d1e7dd", color="#198754", style="filled", width=1.2, fixedsize=true];
        LoadInfo -> VirtualUsers [style=invis];
    }

    subgraph cluster_api {
        label="FastAPI Backend Endpoints";
        style=filled;
        fillcolor="#f8f9fa";
        color="#dee2e6";
        fontname="Helvetica-Bold";
        fontsize=14;

        Feed [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="#cfe2ff" colspan="2"><b>POST /api/jobs/feed</b></td></tr>
            <tr><td align="left">Median (P50)</td><td align="right">310 ms</td></tr>
            <tr><td align="left">95th Percentile</td><td align="right">450 ms</td></tr>
            <tr><td align="left">Max</td><td align="right">780 ms</td></tr>
            </table>>, shape=none, margin=0];

        Swipe [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="#cfe2ff" colspan="2"><b>POST /api/swipes/record</b></td></tr>
            <tr><td align="left">Median (P50)</td><td align="right">12 ms</td></tr>
            <tr><td align="left">95th Percentile</td><td align="right">22 ms</td></tr>
            <tr><td align="left">Max</td><td align="right">110 ms</td></tr>
            </table>>, shape=none, margin=0];

        CV [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="#fff3cd" colspan="2"><b>POST /api/generate-cv</b><br/><font point-size="10">(LLM Call)</font></td></tr>
            <tr><td align="left">Median (P50)</td><td align="right">1900 ms</td></tr>
            <tr><td align="left">95th Percentile</td><td align="right">3100 ms</td></tr>
            <tr><td align="left">Max</td><td align="right">6500 ms</td></tr>
            </table>>, shape=none, margin=0];
    }

    VirtualUsers -> Feed [label=" 15 RPS", color="#0d6efd", fontcolor="#0d6efd", penwidth=2];
    VirtualUsers -> Swipe [label=" 25 RPS", color="#0d6efd", fontcolor="#0d6efd", penwidth=2];
    VirtualUsers -> CV [label=" 0.5 RPS", color="#ffc107", fontcolor="#ffc107", penwidth=1.5];
}
